# Bllumo Environment Configuration

# Server-only administrator passkey and session-signing secrets (32+ random characters each).
ADMIN_SECRET_KEY=
ADMIN_SESSION_SECRET=
SUPPRESSION_SECRET=
RATE_LIMIT_SECRET=

# Server-only Supabase project. Never expose the service key to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Production requires Supabase. Development may explicitly use development-file.
BLLUMO_STORAGE=supabase
APP_ORIGIN=https://www.bllumo.com
NEXT_PUBLIC_SITE_URL=https://www.bllumo.com

# Keep registration closed until the owner checklist and qualified review are complete.
WAITLIST_ENABLED=false
AGE_POLICY=adults-18-plus
LEGAL_REVIEW_APPROVED=false
PRIVACY_OPERATIONS_APPROVED=false
CONTACT_INBOX_VERIFIED=false
PRIVACY_INBOX_VERIFIED=false
PUBLIC_OPERATOR_NAME=
PUBLIC_DATABASE_REGION=
PUBLIC_BACKUP_RETENTION=
PUBLIC_WAITLIST_RETENTION=
